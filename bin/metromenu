#!/usr/bin/env bash
# Launcher for the start menu. Can be used directly from the source tree.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

if [[ -n "${METROMENU_HOME:-}" && -d "${METROMENU_HOME}/metromenu" ]]; then
    ROOT="${METROMENU_HOME}"
elif [[ -d "${HERE}/metromenu" ]]; then
    ROOT="${HERE}"
else
    ROOT="$(cd "${HERE}/.." && pwd)"
fi

export PYTHONPATH="${ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
exec python3 -m metromenu "$@"
